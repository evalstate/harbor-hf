{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harbor-hf.invalid/schemas/leaderboard-snapshot-v1.schema.json",
  "title": "HarborHFLeaderboardSnapshotV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "record_id",
    "created_at",
    "actor",
    "sqlite_key",
    "sqlite_digest",
    "source_digest",
    "entry_count"
  ],
  "properties": {
    "schema_version": { "const": "v1" },
    "kind": { "const": "leaderboard.snapshot" },
    "record_id": { "$ref": "#/$defs/LeaderboardSnapshotId" },
    "created_at": { "type": "string", "format": "date-time" },
    "actor": { "$ref": "#/$defs/LeaderboardSnapshotActor" },
    "sqlite_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "sqlite_digest": { "$ref": "#/$defs/LeaderboardSnapshotDigest" },
    "source_digest": { "$ref": "#/$defs/LeaderboardSnapshotDigest" },
    "entry_count": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "LeaderboardSnapshotId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"
    },
    "LeaderboardSnapshotDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "LeaderboardSnapshotActor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "role"],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "role": {
          "enum": ["operator", "reader", "service", "migration"]
        }
      }
    }
  }
}
