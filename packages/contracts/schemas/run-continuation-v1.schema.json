{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harborframework.com/schemas/harbor-hf/run-continuation-v1.schema.json",
  "title": "Harbor-HF run continuation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["reason", "confirmed"],
  "properties": {
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "confirmed": {
      "const": true
    }
  }
}
